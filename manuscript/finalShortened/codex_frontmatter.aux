\@writefile{toc}{\contentsline {subsubsection}{\numberline {\mbox  {I-B}2}Three Competitive Advantages of O-ISAC}{3}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{\numberline {\mbox  {I-B}2a}Advantage 1: Capacity Scaling Through Spectral Abundance and Multiplexing}{3}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{\numberline {\mbox  {I-B}2b}Advantage 2: Enhancing Sensing Precision via Ultra-Wide Bandwidth}{3}{}\protected@file@percent }
\citation{O_ISAC_021}
\citation{O_ISAC_003}
\citation{O_ISAC_021}
\citation{O_ISAC_016}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Physical mechanisms behind the three competitive advantages of O-ISAC. (Left) Capacity scaling is achieved via dense Multiplexing (WDM/SDM), enabling aggregate rates of 241.85 Tb/s (wired) \cite  {O_ISAC_046} and dense parallel channels (wireless) \cite  {O_ISAC_021}. (Center) Sensing precision is driven by ultra-wide effective bandwidth, enabling wireless range resolution down to $\Delta r_{\min } = 2.5$ mm and $\text  {CRQ}_{\Delta }$ of $4.8\times 10^{13}$ bps/m (480 Gbps/cm) \cite  {O_ISAC_105}. (Right) Spatial isolation is inherent to narrow optical beams, reducing multi-user interference and RF-EMI susceptibility compared to wide RF sectors.}}{4}{}\protected@file@percent }
\newlabel{fig:fig2}{{2}{4}{}{figure.2}{}}
\@writefile{toc}{\contentsline {paragraph}{\numberline {\mbox  {I-B}2c}Advantage 3: Spatial Isolation and Reduced RF-EMI Coupling}{4}{}\protected@file@percent }
